// --- MEMOIZED DISH CARD COMPONENT ---
const DishCard = memo(({ item, onAddToCart, onCustomiseItem }) => {
  return (
    <div className="bg-[#161619] rounded-2xl border border-neutral-800/80 overflow-hidden hover:border-amber-500/40 transition-all duration-300 flex flex-col justify-between group">
      <div>
        <div className="relative h-48 bg-neutral-900 overflow-hidden">
          <img
            src={item.image}
            alt={item.name}
            loading="lazy"
            className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div className="absolute inset-0 bg-gradient-to-t from-[#161619] via-transparent to-black/40" />

          <div className="absolute top-3 left-3 flex items-center space-x-2">
            <span className={`w-4 h-4 rounded-full border-2 p-0.5 flex items-center justify-center bg-black/60 ${
              item.isVeg ? 'border-emerald-500' : 'border-rose-500'
            }`}>
              <span className={`w-2 h-2 rounded-full ${item.isVeg ? 'bg-emerald-500' : 'bg-rose-500'}`} />
            </span>
            {item.isPopular && (
              <span className="bg-amber-500 text-black font-bold text-[10px] px-2 py-0.5 rounded-full uppercase tracking-wider">
                Bestseller
              </span>
            )}
          </div>

          {!item.isAvailable && (
            <div className="absolute inset-0 bg-black/80 backdrop-blur-xs flex items-center justify-center">
              <span className="text-xs font-bold text-rose-400 uppercase tracking-widest border border-rose-500/40 px-3 py-1 rounded">
                Sold Out Today
              </span>
            </div>
          )}
        </div>

        <div className="p-5 space-y-2">
          <div className="flex items-start justify-between gap-2">
            <h3 className="text-base font-bold font-serif text-white group-hover:text-amber-400 transition">
              {item.name}
            </h3>
            <span className="text-[11px] bg-neutral-800/80 px-2 py-0.5 rounded text-neutral-400 border border-neutral-700/60 shrink-0">
              {item.spiceLevel}
            </span>
          </div>
          <p className="text-xs text-neutral-400 line-clamp-2 leading-relaxed">
            {item.description}
          </p>
        </div>
      </div>

      <div className="px-5 pb-5 pt-2 flex items-center justify-between border-t border-neutral-800/60">
        <div>
          <span className="text-[10px] text-neutral-500 block uppercase">Price</span>
          <span className="text-lg font-bold text-amber-400">₹{item.price}</span>
        </div>

        {item.isAvailable ? (
          <div className="flex items-center space-x-2">
            <button
              onClick={() => onCustomiseItem(item)}
              className="p-2 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-300 text-xs font-semibold border border-neutral-700 transition"
              title="Customize Spice & Extras"
            >
              Custom
            </button>
            <button
              onClick={() => onAddToCart(item)}
              className="px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white font-bold text-xs shadow-md transition flex items-center space-x-1"
            >
              <Plus className="w-3.5 h-3.5" />
              <span>Add</span>
            </button>
          </div>
        ) : (
          <button disabled className="px-3 py-1.5 rounded-xl bg-neutral-800 text-neutral-500 text-xs font-medium cursor-not-allowed">
            Unavailable
          </button>
        )}
      </div>
    </div>
  );
});

// --- MAIN APPLICATION COMPONENT ---
export default function App() {
  // State Initialization
  const [restaurant, setRestaurant] = useState(() => {
    const saved = localStorage.getItem('muntaj_settings');
    return saved ? JSON.parse(saved) : INITIAL_RESTAURANT_INFO;
  });

  const [menuItems, setMenuItems] = useState(() => {
    const saved = localStorage.getItem('muntaj_menu');
    return saved ? JSON.parse(saved) : INITIAL_MENU_ITEMS;
  });

  const [orders, setOrders] = useState(() => {
    const saved = localStorage.getItem('muntaj_orders');
    return saved ? JSON.parse(saved) : INITIAL_ORDERS;
  });

  const [cart, setCart] = useState(() => {
    const saved = localStorage.getItem('muntaj_cart');
    return saved ? JSON.parse(saved) : [];
  });

  // Passcode Security Configuration (Never expose passcode in UI)
  const [adminPasscodeHash, setAdminPasscodeHash] = useState(() => {
    return localStorage.getItem('muntaj_admin_code') || (import.meta.env?.VITE_ADMIN_PASSCODE || "admin123");
  });

  // Navigation & UI States
  const [activeTab, setActiveTab] = useState('home');
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [trackedOrderId, setTrackedOrderId] = useState(null);

  // Menu Filters
  const [selectedCategory, setSelectedCategory] = useState('All');
  const [searchQuery, setSearchQuery] = useState('');
  const [isVegOnly, setIsVegOnly] = useState(false);
  const [priceSort, setPriceSort] = useState('default');

  // Customization Modal
  const [customizingItem, setCustomizingItem] = useState(null);
  const [selectedSpice, setSelectedSpice] = useState('Medium');
  const [addExtraEgg, setAddExtraEgg] = useState(false);
  const [addExtraRaita, setAddExtraRaita] = useState(false);
  const [itemNote, setItemNote] = useState('');

  // Admin Auth State
  const [isAdminAuthenticated, setIsAdminAuthenticated] = useState(() => {
    return sessionStorage.getItem('muntaj_admin_auth') === 'true';
  });
  const [inputPasscode, setInputPasscode] = useState('');
  const [adminAuthError, setAdminAuthError] = useState('');
  const [adminActiveTab, setAdminActiveTab] = useState('orders');
  const [editingMenuItem, setEditingMenuItem] = useState(null);

  // Policy Modal State
  const [activePolicyModal, setActivePolicyModal] = useState(null);

  // Persistence Effects
  useEffect(() => {
    localStorage.setItem('muntaj_settings', JSON.stringify(restaurant));
  }, [restaurant]);

  useEffect(() => {
    localStorage.setItem('muntaj_menu', JSON.stringify(menuItems));
  }, [menuItems]);

  useEffect(() => {
    localStorage.setItem('muntaj_orders', JSON.stringify(orders));
  }, [orders]);

  useEffect(() => {
    localStorage.setItem('muntaj_cart', JSON.stringify(cart));
  }, [cart]);

  // Optimized Cart Callbacks
  const handleAddToCart = useCallback((item, options = {}) => {
    const cartItemId = `${item.id}-${options.spiceLevel || 'Medium'}-${options.addEgg ? 'egg' : 'noegg'}-${options.addRaita ? 'raita' : 'noraita'}`;
    const extraPrice = (options.addEgg ? 20 : 0) + (options.addRaita ? 15 : 0);
    const unitPrice = item.price + extraPrice;

    setCart(prev => {
      const existing = prev.find(i => i.cartItemId === cartItemId);
      if (existing) {
        return prev.map(i => i.cartItemId === cartItemId ? { ...i, quantity: i.quantity + 1 } : i);
      }
      return [...prev, {
        cartItemId,
        id: item.id,
        name: item.name,
        basePrice: item.price,
        unitPrice,
        quantity: 1,
        isVeg: item.isVeg,
        spiceLevel: options.spiceLevel || 'Medium',
        addEgg: !!options.addEgg,
        addRaita: !!options.addRaita,
        note: options.note || '',
        image: item.image
      }];
    });
    setCustomizingItem(null);
    setIsCartOpen(true);
  }, []);

  const updateCartQuantity = useCallback((cartItemId, delta) => {
    setCart(prev => prev.map(item => {
      if (item.cartItemId === cartItemId) {
        const newQty = item.quantity + delta;
        return newQty > 0 ? { ...item, quantity: newQty } : null;
      }
      return item;
    }).filter(Boolean));
  }, []);

  const removeFromCart = useCallback((cartItemId) => {
    setCart(prev => prev.filter(item => item.cartItemId !== cartItemId));
  }, []);

  // Cart Totals
  const cartSubtotal = useMemo(() => {
    return cart.reduce((sum, item) => sum + (item.unitPrice * item.quantity), 0);
  }, [cart]);

  const cartGst = useMemo(() => {
    return Math.round((cartSubtotal * restaurant.gstRate / 100) * 100) / 100;
  }, [cartSubtotal, restaurant.gstRate]);

  const cartTotal = useMemo(() => {
    if (cart.length === 0) return 0;
    return cartSubtotal + cartGst + (restaurant.deliveryEnabled ? restaurant.deliveryFee : 0);
  }, [cartSubtotal, cartGst, restaurant]);

  // Categories Calculation
  const categories = useMemo(() => {
    const set = new Set(menuItems.map(i => i.category));
    return ['All', 'Popular', ...Array.from(set)];
  }, [menuItems]);

  // Filtered Menu Items
  const filteredMenuItems = useMemo(() => {
    return menuItems.filter(item => {
      const matchesCategory = selectedCategory === 'All'
        ? true
        : selectedCategory === 'Popular'
          ? item.isPopular
          : item.category === selectedCategory;

      const matchesSearch = item.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
                            item.description.toLowerCase().includes(searchQuery.toLowerCase());

      const matchesVeg = isVegOnly ? item.isVeg : true;

      return matchesCategory && matchesSearch && matchesVeg;
    }).sort((a, b) => {
      if (priceSort === 'low-high') return a.price - b.price;
      if (priceSort === 'high-low') return b.price - a.price;
      return 0;
    });
  }, [menuItems, selectedCategory, searchQuery, isVegOnly, priceSort]);

  // Admin Auth Handler
  const handleAdminLogin = useCallback((e) => {
    e.preventDefault();
    if (inputPasscode === adminPasscodeHash) {
      setIsAdminAuthenticated(true);
      sessionStorage.setItem('muntaj_admin_auth', 'true');
      setAdminAuthError('');
      setInputPasscode('');
    } else {
      setAdminAuthError('Invalid administrator credentials.');
    }
  }, [inputPasscode, adminPasscodeHash]);

  const handleAdminLogout = useCallback(() => {
    setIsAdminAuthenticated(false);
    sessionStorage.removeItem('muntaj_admin_auth');
  }, []);

  return (
    <div className="min-h-screen bg-[#0d0d0f] text-[#f4f4f5] font-sans antialiased flex flex-col selection:bg-amber-500 selection:text-black">
      
      {/* 1. ANNOUNCEMENT BAR */}
      {restaurant.announcementActive && (
        <div className="bg-gradient-to-r from-amber-950 via-orange-900 to-amber-950 text-amber-200 px-4 py-2 text-xs font-medium border-b border-amber-800/40 flex items-center justify-between shadow-inner">
          <div className="flex items-center space-x-2 mx-auto text-center truncate">
            <Sparkles className="w-4 h-4 text-amber-400 shrink-0 animate-pulse" />
            <span className="truncate">{restaurant.announcement}</span>
            <span className="hidden md:inline-block text-[10px] bg-amber-900/60 text-amber-300 px-2 py-0.5 rounded border border-amber-700/50">
              H B Colony Branch
            </span>
          </div>
        </div>
      )}

      {/* 2. HEADER & NAVIGATION */}
      <header className="sticky top-0 z-40 bg-[#121215]/90 backdrop-blur-md border-b border-neutral-800/80 shadow-2xl">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
          
          {/* Logo */}
          <button 
            onClick={() => setActiveTab('home')}
            className="flex items-center space-x-3 text-left focus:outline-none group"
          >
            <div className="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 p-0.5 shadow-lg group-hover:scale-105 transi